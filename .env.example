# Phase 1 needs no key. From Phase 2 on the project reads only CHESS_FORCES_API_KEY.
# Export it in the shell (the shell wins over .env), or copy this file to .env (gitignored)
# and run scripts with: uv run --env-file .env ...   Never commit a key.
CHESS_FORCES_API_KEY=
# Local Syzygy 3-4-5 tables, relative to this directory.
SYZYGY_PATH=../syzygy
